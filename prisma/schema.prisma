generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  service   String
  date      String?
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
